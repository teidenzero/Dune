# Godot engine cache and import data
.godot/
*.import
.import/

# Godot editor data that lands in the project directory
export_templates/
feature_profiles/
script_templates/
text_editor_themes/

# Local validation output: redirected editor data, screenshots, engine logs
.validation/
tests/*.log

# OS and scratch
*.tmp
.DS_Store
Thumbs.db

# Private design and development documentation (not for the public repo)
ARCHITECTURE.md
DEVLOG.md
DUNE_PROTOTYPE_PLAN.md
tests/README.md
M9_PLAYTEST.md
M10_PLAYTEST.md

# Generated character art: the game uses the packed strips copied to
# assets/characters/<unit>/. Keep the manifests, prompts and reference image;
# the review GIFs, source attempts, zips and duplicate strips stay local.
assets/characters/*/generated/review/
assets/characters/*/generated/source/
assets/characters/*/generated/*.zip
assets/characters/*/generated/*.png
!assets/characters/*/generated/*_reference.png
