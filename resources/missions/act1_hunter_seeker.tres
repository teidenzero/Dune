[gd_resource type="Resource" script_class="MissionDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/campaign/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/campaign/objective_definition.gd" id="2"]

[sub_resource type="Resource" id="obj_needle"]
script = ExtResource("2")
id = &"needle"
title = "Survive the hunter-seeker"
description = "It homes on movement. Be still; seize it when it is within reach."
primary = true

[sub_resource type="Resource" id="obj_operator"]
script = ExtResource("2")
id = &"operator"
title = "Find the operator"
description = "Someone guided it from inside the house."

[resource]
script = ExtResource("1")
id = &"act1_hunter_seeker"
title = "The Hunter-Seeker"
briefing = "A word before you sleep, young master. The Harkonnen left this house in a hurry, and a hurried enemy leaves things behind: hollow walls, forgotten passages, and perhaps a man or a machine. My people have not swept every corner yet. Tonight, trust nothing that moves."
faction_at_stake = &"fremen"
objectives = Array[ExtResource("2")]([SubResource("obj_needle"), SubResource("obj_operator")])
stakes = {
"clean": {
"resources": {
&"intel": 2,
&"influence": 1
}
},
"noisy": {
"resources": {
&"intel": 1
}
},
"partial": {
"heat": 1
},
"failure": {
"heat": 1
}
}
solo_scene = "res://scenes/missions/act1/hunter_seeker.tscn"
heading = "ACT I  ·  1.1"
briefing_speaker = "THUFIR"
briefing_image = "card_hunter_seeker"
intel = PackedStringArray()
solo_intel = PackedStringArray("A hunter-seeker homes on movement. While you are still, it can only search for you.", "It must come within arm's reach before you can seize it (left-click it). Grab for it too soon and you give yourself away.", "A seeker is guided by an operator, somewhere close, watching through its eye. Find him before he gets out of the house.", "The household staff know this house better than we do. The Fremen housekeeper, Mapes, keeps to the kitchens below.")
